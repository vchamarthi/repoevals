+def weighted_mean(x, w):
+    """Mean of x weighted by w."""
+    x = np.asarray(x, dtype=np.float64)
+    w = np.asarray(w, dtype=np.float64)
+    total = 0.0
+    for i in range(len(x) - 1):
+        total += x[i] * w[i]
+    return float(total / w.sum())
